---
// Placeholder mark drawn after the Figma mock-up (circle with grain lines).
// Replace with the original vector logo once the workshop sends it.
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
const id = `grain-${Math.random().toString(36).slice(2, 8)}`;
const lines = [-30, -21, -12, -3, 6, 15, 24, 33];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={id}><circle cx="24" cy="24" r="21.5" /></clipPath>
  </defs>
  <g clip-path={`url(#${id})`} fill="none" stroke="currentColor" stroke-width="1.6">
    {lines.map((o) => <path d={`M${-4 + o} 52 C ${10 + o} 36, ${14 + o} 22, ${30 + o} -4`} />)}
  </g>
  <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-width="2" />
</svg>
