---
import Logo from '../assets/logo/logo-pracownia.svg';
import { site, url } from '../data/site';
---

<header class="site-header wrap">
  <a class="brand" href={url('/')} aria-label={`${site.name} – ${site.tagline.toLowerCase()}, strona główna`}>
    <Logo class="logo" aria-hidden="true" />
  </a>
  <button
    type="button"
    class="menu-toggle"
    aria-expanded="false"
    aria-controls="site-nav"
    data-menu-toggle
  >
    <span class="menu-icon" aria-hidden="true"></span>
    <span class="menu-label">Menu</span>
  </button>
  <nav id="site-nav" aria-label="Główna nawigacja">
    <ul>
      <li><a href={url('/#realizacje')}>Realizacje</a></li>
      <li><a href={url('/#jak-pracujemy')}>Jak pracujemy</a></li>
      <li><a href={url('/#kontakt')}>Kontakt</a></li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        set(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.1rem;
  }

  .brand {
    display: inline-flex;
    text-decoration: none;
  }

  .logo {
    display: block;
    width: auto;
    height: clamp(2.5rem, 1.8rem + 1.6vw, 3.75rem);
  }

  ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    text-decoration: none;
    padding-block: 0.5rem;
  }

  nav a:hover {
    text-decoration: underline;
  }

  .menu-toggle {
    display: none;
  }

  /* Phones: collapsed menu behind a toggle button */
  @media (max-width: 40rem) {
    :global(.js) .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      margin-left: auto;
      padding: 0.6rem 0;
      border: 0;
      background: none;
      color: inherit;
      font: inherit;
      cursor: pointer;
    }

    .menu-icon,
    .menu-icon::before,
    .menu-icon::after {
      display: block;
      width: 1.25rem;
      height: 1.5px;
      background: currentColor;
      transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .menu-icon {
      position: relative;
    }

    .menu-icon::before,
    .menu-icon::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .menu-icon::before {
      top: -6px;
    }

    .menu-icon::after {
      top: 6px;
    }

    [aria-expanded='true'] .menu-icon {
      background: transparent;
    }

    [aria-expanded='true'] .menu-icon::before {
      transform: translateY(6px) rotate(45deg);
    }

    [aria-expanded='true'] .menu-icon::after {
      transform: translateY(-6px) rotate(-45deg);
    }

    /* Without JavaScript the links simply stay visible below the logo */
    .site-header {
      flex-wrap: wrap;
    }

    :global(.js) nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 5;
      padding: 0.5rem var(--gutter) 1.5rem;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }

    :global(.js) nav:global(.open) {
      display: block;
    }

    :global(.js) ul {
      flex-direction: column;
      gap: 0;
    }

    :global(.js) nav a {
      font-size: var(--step-2);
      padding-block: 0.6rem;
    }
  }
</style>
