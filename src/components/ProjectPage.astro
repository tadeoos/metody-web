---
import { Picture } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.astro';
import { url } from '../data/site';

interface Props {
  project: CollectionEntry<'realizacje'>;
  next: CollectionEntry<'realizacje'>;
}

const { project, next } = Astro.props;
const { title, subtitle, zdjecia, photos } = project.data;
const { Content } = await render(project);
const [cover, ...rest] = photos;
---

<Base title={title} description={subtitle ? `${title}: ${subtitle.toLowerCase()}.` : undefined} image={cover.src}>
  <article>
    <div class="wrap top">
      <header class="intro">
        <h1>{title}</h1>
        {subtitle && <p class="subtitle">{subtitle}</p>}
      </header>

      <div class="cover-wrap">
        <Picture
          src={cover.src}
          alt={cover.alt}
          class="cover corner"
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 66rem) 62rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="description">
        <div class="prose">
          <Content />
        </div>
        {zdjecia && <p class="credit">Zdjęcia: {zdjecia}</p>}
      </div>
    </div>

    {
      rest.length > 0 && (
        <Gallery photos={rest} />
      )
    }

    {
      next.id !== project.id && (
        <nav class="wrap next" aria-label="Kolejna realizacja">
          <a href={url(`/realizacje/${next.id}/`)}>
            <span class="next-label">Następna realizacja</span>
            <span class="next-title">{next.data.title}</span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  /* One calm column: title, cover, description, then the gallery. */
  .top {
    display: grid;
    gap: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    padding-block: clamp(1.5rem, 1rem + 3vw, 3.5rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  h1 {
    font-size: var(--text-xl);
    font-weight: 350;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: var(--text-md);
    color: var(--muted);
    margin: 0.6rem 0 0;
  }

  :global(.cover) {
    width: 100%;
    max-height: 85vh;
    object-fit: cover;
  }

  /* Description sits under the cover, indented to the right on wide
     screens so it reads as part of the page rhythm, not a caption. */
  /* The project's story is the main text here, so it gets the larger size */
  .description {
    max-width: 38rem;
    font-size: var(--text-md);
    line-height: 1.5;
  }

  @media (min-width: 56rem) {
    .description {
      margin-left: 28%;
    }
  }

  .credit {
    margin: 1.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .next {
    margin-top: clamp(4rem, 2rem + 6vw, 7rem);
    padding-block: 2rem clamp(3rem, 2rem + 4vw, 5rem);
    border-top: 1px solid var(--line);
  }

  .next a {
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
  }

  .next-label {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .next-title {
    font-size: var(--text-lg);
    line-height: 1.15;
  }

  .next a:hover .next-title {
    color: var(--walnut);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
</style>
