---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

// Calm magazine rhythm inside the content column: a single photo (shifted
// alternately left and right, as in the Figma mock-up), then a pair of photos
// with the same orientation side by side, and so on. Nothing overlaps.
const isPortrait = (p: Photo) => p.src.height > p.src.width * 1.05;
type Item = { photo: Photo; index: number };
type Row =
  | { kind: 'single'; side: 'left' | 'right'; portrait: boolean; items: [Item] }
  | { kind: 'pair'; portrait: boolean; items: [Item, Item] };
const rows: Row[] = [];
let side: 'left' | 'right' = 'right';
for (let i = 0; i < photos.length; i++) {
  const p = photos[i];
  const next = photos[i + 1];
  const last = rows.at(-1);
  if (next && isPortrait(next) === isPortrait(p) && last?.kind !== 'pair') {
    rows.push({ kind: 'pair', portrait: isPortrait(p), items: [{ photo: p, index: i }, { photo: next, index: i + 1 }] });
    i++;
  } else {
    rows.push({ kind: 'single', side, portrait: isPortrait(p), items: [{ photo: p, index: i }] });
    side = side === 'right' ? 'left' : 'right';
  }
}

// Large versions for the lightbox.
const full = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(2400, p.src.width), format: 'webp' })),
);
---

<div class="gallery" data-gallery>
  {
    rows.map((row) => (
      <div
        class:list={[
          'row',
          `row--${row.kind}`,
          row.kind === 'single' && `row--${row.side}`,
          { 'row--portrait': row.portrait },
        ]}
      >
        {row.items.map(({ photo, index }) => (
          <figure>
            <button
              type="button"
              class="open"
              data-index={index}
              data-full={full[index].src}
              data-alt={photo.alt}
              data-caption={photo.caption ?? ''}
              aria-label={`Powiększ zdjęcie: ${photo.alt}`}
            >
              <Picture
                src={photo.src}
                alt={photo.alt}
                formats={['avif', 'webp']}
                widths={[480, 720, 1080, 1440]}
                sizes="(min-width: 66rem) 46rem, 100vw"
              />
            </button>
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))}
      </div>
    ))
  }
</div>

<dialog class="lightbox" aria-label="Powiększone zdjęcie">
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-close" data-close aria-label="Zamknij">Zamknij</button>
  <button type="button" class="lb-btn lb-prev" data-prev aria-label="Poprzednie zdjęcie">‹</button>
  <button type="button" class="lb-btn lb-next" data-next aria-label="Następne zdjęcie">›</button>
  <p class="lb-count" aria-live="polite"></p>
</dialog>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');

  if (gallery && dialog) {
    const buttons = [...gallery.querySelectorAll<HTMLButtonElement>('button.open')];
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const count = dialog.querySelector('.lb-count')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + buttons.length) % buttons.length;
      const b = buttons[current];
      img.src = b.dataset.full!;
      img.alt = b.dataset.alt!;
      caption.textContent = b.dataset.caption || '';
      count.textContent = `${current + 1} / ${buttons.length}`;
    };

    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );

    dialog.addEventListener('close', () => buttons[current]?.focus());
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));

    // Click on the dark backdrop (not the photo) closes the dialog.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.querySelector('figure')) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    let startX: number | null = null;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      startX = null;
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
  }

  .row {
    display: grid;
    gap: var(--gutter);
  }

  figure {
    margin: 0;
  }

  /* Singles: a bit narrower than the column, shifted left or right */
  .row--single figure {
    width: 82%;
  }

  .row--single.row--portrait figure {
    width: 64%;
  }

  .row--right figure {
    margin-left: auto;
  }

  @media (min-width: 48rem) {
    .row--single figure {
      width: 72%;
    }

    .row--single.row--portrait figure {
      width: 48%;
    }

    .row--pair {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .row--pair :global(img) {
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }

    .row--pair.row--portrait :global(img) {
      aspect-ratio: 4 / 5;
    }
  }

  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
    /* Same signature corner as everywhere else */
    border-radius: 0 0 var(--corner-sm) 0;
  }

  .open :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(20 18 16 / 0.96);
    color: #fff;
  }

  .lightbox::backdrop {
    background: rgb(20 18 16 / 0.96);
  }

  .lightbox figure {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    height: 100%;
    padding: 3.5rem 1rem;
  }

  .lightbox img {
    max-width: 100%;
    max-height: calc(100dvh - 8rem);
    width: auto;
    object-fit: contain;
  }

  .lightbox figcaption {
    color: rgb(255 255 255 / 0.75);
    margin: 0;
  }

  .lb-btn {
    position: absolute;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
    cursor: pointer;
    padding: 0.75rem 1rem;
  }

  .lb-close {
    top: 0.5rem;
    right: 0.5rem;
  }

  .lb-prev,
  .lb-next {
    top: 50%;
    translate: 0 -50%;
    font-size: 2.5rem;
    line-height: 1;
  }

  .lb-prev {
    left: 0.25rem;
  }

  .lb-next {
    right: 0.25rem;
  }

  .lb-count {
    position: absolute;
    top: 1.1rem;
    left: 1.25rem;
    margin: 0;
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.75);
  }

  .lb-btn:focus-visible {
    outline-color: #fff;
  }
</style>
