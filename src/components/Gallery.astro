---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

// One large, uncropped photo per row, alternately against the right and left
// screen edge and rounded on the side facing the middle (as in the Figma
// mock-up). Nothing overlaps.
const isPortrait = (p: Photo) => p.src.height > p.src.width * 1.05;
const rows = photos.map((photo, index) => ({
  photo,
  index,
  side: index % 2 === 0 ? 'right' : 'left',
  portrait: isPortrait(photo),
}));

// Large versions for the lightbox.
const full = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(2400, p.src.width), format: 'webp' })),
);
---

<div class="gallery" data-gallery>
  {
    rows.map(({ photo, index, side, portrait }) => (
      <figure class:list={[`item--${side}`, { 'item--portrait': portrait }]}>
        <button
          type="button"
          class="open"
          data-index={index}
          data-full={full[index].src}
          data-alt={photo.alt}
          data-caption={photo.caption ?? ''}
          aria-label={`Powiększ zdjęcie: ${photo.alt}`}
        >
          <Picture
            src={photo.src}
            alt={photo.alt}
            formats={['avif', 'webp']}
            widths={[480, 720, 1080, 1440, 1920]}
            sizes="(min-width: 48rem) 62vw, 90vw"
          />
        </button>
        {photo.caption && <figcaption>{photo.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<Lightbox />

<style>
  .gallery {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  figure {
    margin: 0;
    width: 88vw;
  }

  .item--portrait {
    width: 74vw;
  }

  @media (min-width: 48rem) {
    figure {
      width: 62vw;
    }

    .item--portrait {
      width: 42vw;
    }
  }

  .item--right {
    margin-left: auto;
  }

  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  /* Rounded on the side facing the middle of the page */
  .item--left .open {
    border-radius: 0 var(--corner-sm) var(--corner-sm) 0;
  }

  .item--right .open {
    border-radius: var(--corner-sm) 0 0 var(--corner-sm);
  }

  .open :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .item--left figcaption {
    padding-left: var(--gutter);
  }
</style>
