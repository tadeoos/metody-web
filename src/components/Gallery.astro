---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

// Photos alternate between the left and right edge of the screen (as in the
// Figma mock-up). On wide screens each photo is pulled up next to the previous
// one, so the column reads as a loose zigzag rather than a long stack.
// Sizes are in container-width units (cqw).
const WIDE = { landscape: 48, portrait: 40 };
const ratio = (p: Photo) => p.src.height / p.src.width;
const isPortrait = (p: Photo) => ratio(p) > 1.05;
const items = photos.map((photo, index) => {
  const w = isPortrait(photo) ? WIDE.portrait : WIDE.landscape;
  return { photo, index, side: index % 2 === 0 ? 'right' : 'left', w, h: w * ratio(photo) };
});
// Overlap with the previous photo; capped so a photo never collides with
// the one two steps back on the same side.
const overlap = items.map((it, i) =>
  i === 0 ? 0 : Math.min(0.4 * items[i - 1].h, 0.6 * it.h),
);

// Large versions for the lightbox.
const full = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(2400, p.src.width), format: 'webp' })),
);
---

<div class="gallery" data-gallery>
  {
    items.map(({ photo, index, side, w }) => (
      <figure
        class:list={['item', `item--${side}`, { 'item--portrait': isPortrait(photo) }]}
        style={`--w: ${w}; --ov: ${overlap[index].toFixed(2)}`}
      >
        <button
          type="button"
          class="open"
          data-index={index}
          data-full={full[index].src}
          data-alt={photo.alt}
          data-caption={photo.caption ?? ''}
          aria-label={`Powiększ zdjęcie: ${photo.alt}`}
        >
          <Picture
            src={photo.src}
            alt={photo.alt}
            formats={['avif', 'webp']}
            widths={[480, 720, 1080, 1440]}
            sizes="(min-width: 48rem) 48vw, 90vw"
          />
        </button>
        {photo.caption && <figcaption>{photo.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<dialog class="lightbox" aria-label="Powiększone zdjęcie">
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-close" data-close aria-label="Zamknij">Zamknij</button>
  <button type="button" class="lb-btn lb-prev" data-prev aria-label="Poprzednie zdjęcie">‹</button>
  <button type="button" class="lb-btn lb-next" data-next aria-label="Następne zdjęcie">›</button>
  <p class="lb-count" aria-live="polite"></p>
</dialog>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');

  if (gallery && dialog) {
    const buttons = [...gallery.querySelectorAll<HTMLButtonElement>('button.open')];
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const count = dialog.querySelector('.lb-count')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + buttons.length) % buttons.length;
      const b = buttons[current];
      img.src = b.dataset.full!;
      img.alt = b.dataset.alt!;
      caption.textContent = b.dataset.caption || '';
      count.textContent = `${current + 1} / ${buttons.length}`;
    };

    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );

    dialog.addEventListener('close', () => buttons[current]?.focus());
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));

    // Click on the dark backdrop (not the photo) closes the dialog.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.querySelector('figure')) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    let startX: number | null = null;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      startX = null;
    });
  }
</script>

<style>
  .gallery {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--gutter);
    max-width: 96rem;
    margin-inline: auto;
  }

  .item {
    margin: 0;
    width: 88cqw;
  }

  .item--portrait {
    width: 74cqw;
  }

  .item--right {
    margin-left: auto;
  }

  @media (min-width: 48rem) {
    .item {
      width: calc(var(--w) * 1cqw);
      margin-top: calc(var(--ov) * -1cqw);
    }

    .item:first-child {
      margin-top: 0;
    }
  }

  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  /* Rounded on the side facing the middle of the page */
  .item--left .open {
    border-radius: 0 var(--corner-sm) var(--corner-sm) 0;
  }

  .item--right .open {
    border-radius: var(--corner-sm) 0 0 var(--corner-sm);
  }

  .open :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .item--left figcaption {
    padding-left: var(--gutter);
  }

  .item--right figcaption {
    padding-right: var(--gutter);
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(20 18 16 / 0.96);
    color: #fff;
  }

  .lightbox::backdrop {
    background: rgb(20 18 16 / 0.96);
  }

  .lightbox figure {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    height: 100%;
    padding: 3.5rem 1rem;
  }

  .lightbox img {
    max-width: 100%;
    max-height: calc(100dvh - 8rem);
    width: auto;
    object-fit: contain;
  }

  .lightbox figcaption {
    color: rgb(255 255 255 / 0.75);
    margin: 0;
  }

  .lb-btn {
    position: absolute;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
    cursor: pointer;
    padding: 0.75rem 1rem;
  }

  .lb-close {
    top: 0.5rem;
    right: 0.5rem;
  }

  .lb-prev,
  .lb-next {
    top: 50%;
    translate: 0 -50%;
    font-size: 2.5rem;
    line-height: 1;
  }

  .lb-prev {
    left: 0.25rem;
  }

  .lb-next {
    right: 0.25rem;
  }

  .lb-count {
    position: absolute;
    top: 1.1rem;
    left: 1.25rem;
    margin: 0;
    font-size: var(--step--1);
    color: rgb(255 255 255 / 0.75);
  }

  .lb-btn:focus-visible {
    outline-color: #fff;
  }
</style>
