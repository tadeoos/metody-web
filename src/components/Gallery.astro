---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

// Desktop: an editorial rhythm inside the page column – a full-width landscape
// shot, then pairs of photos with the same orientation, then full width again.
// Phones: the rows dissolve into one photo per row, alternately against the
// right and left screen edge (as in the Figma mock-up).
const isPortrait = (p: Photo) => p.src.height > p.src.width * 1.05;
type Item = { photo: Photo; index: number; side: 'left' | 'right'; portrait: boolean };
type Row = { kind: 'full' | 'pair' | 'single'; portrait: boolean; items: Item[] };

const item = (i: number): Item => ({
  photo: photos[i],
  index: i,
  side: i % 2 === 0 ? 'right' : 'left',
  portrait: isPortrait(photos[i]),
});

const rows: Row[] = [];
let lastWasFull = false;
for (let i = 0; i < photos.length; i++) {
  const portrait = isPortrait(photos[i]);
  const next = photos[i + 1];
  if (!portrait && (!lastWasFull || !next)) {
    rows.push({ kind: 'full', portrait, items: [item(i)] });
    lastWasFull = true;
  } else if (next && isPortrait(next) === portrait) {
    rows.push({ kind: 'pair', portrait, items: [item(i), item(i + 1)] });
    lastWasFull = false;
    i++;
  } else {
    rows.push({ kind: portrait ? 'single' : 'full', portrait, items: [item(i)] });
    lastWasFull = !portrait;
  }
}

// Large versions for the lightbox.
const full = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(2400, p.src.width), format: 'webp' })),
);
---

<div class="gallery" data-gallery>
  {
    rows.map((row) => (
      <div class:list={['row', `row--${row.kind}`, { 'row--portrait': row.portrait }]}>
        {row.items.map(({ photo, index, side, portrait }) => (
          <figure class:list={[`item--${side}`, { 'item--portrait': portrait }]}>
            <button
              type="button"
              class="open"
              data-index={index}
              data-full={full[index].src}
              data-alt={photo.alt}
              data-caption={photo.caption ?? ''}
              aria-label={`Powiększ zdjęcie: ${photo.alt}`}
            >
              <Picture
                src={photo.src}
                alt={photo.alt}
                formats={['avif', 'webp']}
                widths={[480, 720, 1080, 1440, 1920]}
                sizes={row.kind === 'full' ? '(min-width: 58rem) 54rem, 90vw' : '(min-width: 58rem) 27rem, 90vw'}
              />
            </button>
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))}
      </div>
    ))
  }
</div>

<Lightbox />

<style>
  .gallery {
    display: grid;
  }

  figure {
    margin: 0;
  }

  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .open :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* Phones: one photo per row, alternately against the right and left edge,
     rounded on the side facing the middle of the screen */
  @media (max-width: 47.99rem) {
    .gallery {
      gap: 2.5rem;
    }

    .row {
      display: contents;
    }

    figure {
      width: 88vw;
    }

    .item--portrait {
      width: 74vw;
    }

    .item--right {
      margin-left: auto;
    }

    .item--left .open {
      border-radius: 0 var(--corner-sm) var(--corner-sm) 0;
    }

    .item--right .open {
      border-radius: var(--corner-sm) 0 0 var(--corner-sm);
    }

    .item--left figcaption {
      padding-left: var(--gutter);
    }
  }

  /* Desktop: full-width shots and pairs inside the page column, each with
     the signature rounded corner */
  @media (min-width: 48rem) {
    .gallery {
      gap: var(--gutter);
      max-width: var(--max);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .row {
      display: grid;
      gap: var(--gutter);
    }

    .row--pair {
      grid-template-columns: 1fr 1fr;
    }

    .row--single {
      width: 50%;
      margin-inline: auto;
    }

    .open {
      border-radius: 0 0 var(--corner-sm) 0;
    }

    .row--pair :global(img) {
      aspect-ratio: 5 / 4;
      object-fit: cover;
    }

    .row--pair.row--portrait :global(img) {
      aspect-ratio: 4 / 5;
    }
  }
</style>
