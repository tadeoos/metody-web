---
import Logo from '../assets/logo/logo-pracownia.svg';
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <Logo class="logo" aria-label={`${site.name} – ${site.tagline.toLowerCase()}`} role="img" />
    <p>© {year} {site.owner}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 2.5rem;
  }

  .logo {
    display: block;
    width: auto;
    height: 3rem;
    color: var(--ink);
  }

  p {
    margin: 0;
  }
</style>
