---
import { Picture } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { url } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('realizacje')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'realizacje'>;
  next: CollectionEntry<'realizacje'>;
}

const { project, next } = Astro.props;
const { title, subtitle, zdjecia, photos } = project.data;
const { Content } = await render(project);
const [cover, ...rest] = photos;

---

<Base title={title} description={subtitle ? `${title}: ${subtitle.toLowerCase()}.` : undefined} image={cover.src}>
  <article>
    <div class="wrap top">
      <header class="intro">
        <h1>{title}</h1>
        {subtitle && <p class="subtitle">{subtitle}</p>}
      </header>

      <div class="cover-wrap">
        <Picture
          src={cover.src}
          alt={cover.alt}
          class="cover corner"
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 66rem) 62rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="description">
        <div class="prose">
          <Content />
        </div>
        {zdjecia && <p class="credit">Zdjęcia: {zdjecia}</p>}
      </div>
    </div>

    {
      rest.length > 0 && (
        <Gallery photos={rest} />
      )
    }

    {
      next.id !== project.id && (
        <nav class="wrap next" aria-label="Kolejna realizacja">
          <a href={url(`/realizacje/${next.id}/`)}>
            <span class="next-label">Następna realizacja</span>
            <span class="next-title">{next.data.title}</span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  /* Phones: title, cover, description. Desktop: title and description side
     by side above the cover. */
  .top {
    display: grid;
    grid-template-areas: 'intro' 'cover' 'description';
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem) 4rem;
    padding-block: clamp(1.5rem, 1rem + 3vw, 3.5rem) clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  @media (min-width: 56rem) {
    .top {
      grid-template-columns: 1fr 1.4fr;
      grid-template-areas: 'intro description' 'cover cover';
      align-items: end;
    }
  }

  .intro {
    grid-area: intro;
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 350;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: var(--step-1);
    color: var(--muted);
    margin: 0.75rem 0 0;
  }

  .cover-wrap {
    grid-area: cover;
  }

  :global(.cover) {
    width: 100%;
    max-height: 85vh;
    object-fit: cover;
  }

  .description {
    grid-area: description;
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .credit {
    margin: 1.25rem 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .next {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .next a {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
  }

  .next-label {
    color: var(--muted);
  }

  .next-title {
    font-size: var(--step-2);
    line-height: 1.15;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
</style>
