---
import { Picture } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { url } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('realizacje')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'realizacje'>;
  next: CollectionEntry<'realizacje'>;
}

const { project, next } = Astro.props;
const { title, subtitle, metryczka, photos } = project.data;
const { Content } = await render(project);
const [cover, ...rest] = photos;

const facts = [
  ['Projekt', metryczka.projekt],
  ['Wykonanie', metryczka.wykonanie],
  ['Inwestor', metryczka.inwestor],
  ['Rok', metryczka.rok],
  ['Materiały', metryczka.materialy],
  ['Wymiary', metryczka.wymiary],
  ['Zdjęcia', metryczka.zdjecia],
].filter(([, v]) => v !== undefined && v !== '') as [string, string | number][];
---

<Base title={title} description={subtitle ? `${title}: ${subtitle.toLowerCase()}.` : undefined} image={cover.src}>
  <article>
    <header class="wrap intro">
      <a class="back" href={url('/#realizacje')}>Wszystkie realizacje</a>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
    </header>

    <div class="wrap">
      <Picture
        src={cover.src}
        alt={cover.alt}
        class="cover corner"
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 76rem) 72rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="wrap details">
      {
        facts.length > 0 && (
          <dl class="facts">
            {facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <div class="prose description">
        <Content />
      </div>
    </div>

    {
      rest.length > 0 && (
        <div class="wrap">
          <Gallery photos={rest} />
        </div>
      )
    }

    {
      next.id !== project.id && (
        <nav class="wrap next" aria-label="Kolejna realizacja">
          <a href={url(`/realizacje/${next.id}/`)}>
            <span class="next-label">Następna realizacja</span>
            <span class="next-title">{next.data.title}</span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .intro {
    padding-block: clamp(1.5rem, 1rem + 3vw, 3.5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--muted);
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 350;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: var(--step-1);
    color: var(--muted);
    margin: 0.75rem 0 0;
  }

  :global(.cover) {
    width: 100%;
    max-height: 85vh;
    object-fit: cover;
  }

  .details {
    display: grid;
    gap: 2.5rem 4rem;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  @media (min-width: 56rem) {
    .details {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }

  .facts {
    margin: 0;
    padding: 1.5rem 1.75rem;
    border: 1.5px solid var(--ink);
    border-radius: 0 0 var(--corner-sm) 0;
    font-size: var(--step--1);
  }

  .facts div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 0.3rem;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  .description {
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .next {
    padding-block: clamp(4rem, 2rem + 6vw, 7rem);
  }

  .next a {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
  }

  .next-label {
    color: var(--muted);
  }

  .next-title {
    font-size: var(--step-3);
    line-height: 1.15;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
</style>
