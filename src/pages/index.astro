---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StepIcon from '../components/StepIcon.astro';
import { site, telHref, url } from '../data/site';
import hero from '../content/realizacje/stara-ochota/01.jpg';

const projects = (await getCollection('realizacje')).sort((a, b) => a.data.order - b.data.order);

const steps = [
  {
    title: 'Ustalenie ram współpracy',
    text: [
      'Na wstępie musimy wiedzieć, co i w jakim terminie mamy zbudować. Najwygodniej rozmawiać o tym w oparciu o projekt. W przypadku nieskomplikowanych realizacji wystarczy nawet szkic na serwetce. Jeśli ma powstać coś większego, przyda się bardziej zaawansowany projekt – bez obaw, możemy Cię w tym wesprzeć!',
    ],
  },
  {
    title: 'Wycena',
    text: [
      'Na podstawie omówionego projektu przygotujemy wycenę. Przedstawimy w niej, z jakich konkretnie materiałów powstaną Twoje meble, jakie zastosujemy okucia i wykończenie. Koszt przygotowania wyceny jest po naszej stronie.',
      'Jeśli jednak z góry wiadomo, że nie będziemy realizować Twojego zlecenia, bo na przykład nie zgrywamy się terminowo, a i tak chcesz dostać od nas wycenę, możemy potraktować to jako odrębną, odpłatną usługę.',
    ],
  },
  {
    title: 'Pomiar i projekt wykonawczy',
    text: [
      'Gdy już będziemy wiedzieć co, kiedy i za ile, dopniemy sprawę od strony formalnej i poprosimy Cię o zaliczkę. Pracę zaczniemy od szczegółowych pomiarów i rysunków technicznych. To też czas na ostatnie, najbardziej szczegółowe decyzje – na przykład o układzie liści wybranego przez Ciebie forniru czy sposobie jego malowania.',
    ],
  },
  {
    title: 'Praca w stolarni',
    text: [
      'Możliwie dużą część pracy wykonamy w naszej pracowni. Na tym etapie nie będziemy nadmiernie zawracać Ci głowy.',
    ],
  },
  {
    title: 'Montaż',
    text: [
      'W umówionym terminie przyjedziemy do Ciebie z przygotowanymi w pracowni meblami. Na miejscu złożymy je w całość, dotniemy i doszlifujemy tak, żeby ostateczny efekt był jak najlepszy.',
    ],
  },
] as const;
---

<Base>
  <section class="intro wrap" aria-labelledby="intro-title">
    <Picture
      src={hero}
      alt="Salon z biblioteką od podłogi do sufitu na drewnianych regałach"
      class="intro-image corner"
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="(min-width: 66rem) 62rem, 100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="intro-text">
      <h1 id="intro-title">Specjalizujemy się w&nbsp;meblach na zamówienie.</h1>
      <div class="prose about">
        <p>
          Lubimy niestandardowe zlecenia i rozumiemy, że niuanse często mają olbrzymie znaczenie dla
          ostatecznego efektu. Działamy w skali rzemieślniczej, dzięki czemu możemy poświęcić na Twój
          projekt tyle uwagi, ile tylko będzie potrzebne.
        </p>
      </div>
    </div>
  </section>

  <section id="realizacje" class="section wrap projects" aria-labelledby="realizacje-title">
    <h2 id="realizacje-title" class="section-title">Wybrane realizacje</h2>
    <ul class="project-grid">
      {
        projects.map((p, i) => (
          <li class:list={['project', { 'project--wide': i === 0 }]}>
            <a href={url(`/realizacje/${p.id}/`)}>
              <Picture
                src={p.data.tile ?? p.data.photos[0].src}
                alt=""
                class="project-image corner"
                formats={['avif', 'webp']}
                widths={[480, 720, 1080, 1440]}
                sizes={i === 0 ? '(min-width: 76rem) 72rem, 100vw' : '(min-width: 48rem) 36rem, 100vw'}
              />
              <h3>{p.data.title}</h3>
              {p.data.subtitle && <p>{p.data.subtitle}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="jak-pracujemy" class="process" aria-labelledby="jak-pracujemy-title">
    <div class="section wrap process-inner">
      <div class="process-intro">
        <h2 id="jak-pracujemy-title" class="section-title">Jak pracujemy</h2>
        <p>Od pierwszej rozmowy do montażu w pięciu krokach. Kliknij krok, żeby przeczytać więcej.</p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <details>
                <summary>
                  <StepIcon n={(i + 1) as 1 | 2 | 3 | 4 | 5} />
                  <span class="step-title">{s.title}</span>
                  <span class="step-toggle" aria-hidden="true" />
                </summary>
                <div class="step-body">
                  {s.text.map((t) => (
                    <p>{t}</p>
                  ))}
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="kontakt" class="section wrap contact" aria-labelledby="kontakt-title">
    <h2 id="kontakt-title" class="section-title">Kontakt</h2>
    <p class="contact-lead">Masz pomysł na mebel? Napisz albo zadzwoń – zaczniemy od rozmowy.</p>
    <dl class="contact-list">
      {site.email && (
        <div>
          <dt>E-mail</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
      )}
      {site.phone && (
        <div>
          <dt>Telefon</dt>
          <dd><a href={telHref(site.phone)}>{site.phone}</a></dd>
        </div>
      )}
    </dl>
    {
      (site.facebook || site.instagram) && (
        <p class="social">
          {site.facebook && <a href={site.facebook}>Facebook</a>}
          {site.instagram && <a href={site.instagram}>Instagram</a>}
        </p>
      )
    }
  </section>
</Base>

<style>
  /* Intro: a wide photo with the headline and about text in one column
     beneath it – logo, photo and text all fit on the first screen */
  .intro {
    display: grid;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    padding-block: clamp(1rem, 0.5rem + 2vw, 2.5rem) clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }

  .intro-text {
    display: grid;
    gap: 1rem;
  }

  .about p {
    margin-bottom: 0;
  }

  /* Sits right above the about text, so it stays a step below the page-headline size */
  h1 {
    font-size: clamp(1.625rem, 1.35rem + 0.9vw, 2.25rem); /* 26 → 36px */
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  :global(.intro-image) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 48rem) {
    :global(.intro-image) {
      aspect-ratio: 2 / 1;
      max-height: 58svh;
    }
  }

  /* Projects */
  .projects {
    padding-top: 0;
  }

  .project-grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem) var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .project-grid {
      grid-template-columns: 1fr 1fr;
    }
    .project--wide {
      grid-column: 1 / -1;
    }
  }

  .project a {
    display: block;
    text-decoration: none;
  }

  :global(.project-image) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: border-radius 0.4s ease;
  }

  @media (min-width: 48rem) {
    .project--wide :global(.project-image) {
      aspect-ratio: 16 / 9;
    }
  }

  /* The corner tightens on hover, a nod to the rounded furniture edges */
  .project a:hover :global(.project-image),
  .project a:focus-visible :global(.project-image) {
    border-bottom-right-radius: var(--corner-sm);
  }

  .project h3 {
    font-size: var(--text-md);
    margin-top: 1.1rem;
  }

  .project p {
    margin: 0.35rem 0 0;
    color: var(--muted);
  }

  .project a:hover h3 {
    color: var(--walnut);
  }

  /* Process */
  .process {
    background: var(--niche);
    color: var(--niche-ink);
    border-radius: 0 var(--corner) 0 0;
  }

  .process-inner {
    display: grid;
    gap: 2rem 4rem;
  }

  @media (min-width: 56rem) {
    .process-inner {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }

  .process-intro p {
    max-width: 22rem;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li + li {
    border-top: 1px solid color-mix(in srgb, var(--niche-ink) 22%, transparent);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .step-title {
    flex: 1;
    font-size: var(--text-md);
    line-height: 1.3;
  }

  /* Chevron that flips when the step is open */
  .step-toggle {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-right: 0.3rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-25%) rotate(45deg);
    transition: transform 0.25s ease;
  }

  details[open] .step-toggle {
    transform: translateY(25%) rotate(225deg);
  }

  .step-body {
    padding: 0 0 1.5rem calc(48px + 1.25rem);
    max-width: calc(var(--measure) + 48px + 1.25rem);
  }

  @media (max-width: 30rem) {
    .step-body {
      padding-left: 0;
    }
  }

  /* Contact */
  .contact-lead {
    max-width: 30rem;
  }

  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem clamp(2rem, 1rem + 5vw, 5rem);
    margin: 2.5rem 0 0;
  }

  dt {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: 0.25rem;
  }

  dd {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  dd a {
    text-decoration-thickness: 1.5px;
  }

  .social {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
  }
</style>
